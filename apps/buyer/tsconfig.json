{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@ymenet/theme": ["../../packages/theme/index.ts"],
      "@ymenet/utils": ["../../packages/utils/index.ts"],
      "@ymenet/ui": ["../../packages/ui/index.ts"]
    }
  },
  "include": ["src"]
}
